{
  "name": "@portfolio/vue-data-table",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Accessible, typed data table component for Vue 3",
  "files": ["dist"],
  "main": "./dist/vue-data-table.umd.cjs",
  "module": "./dist/vue-data-table.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/vue-data-table.js", "require": "./dist/vue-data-table.umd.cjs" } },
  "scripts": { "build": "vite build && vue-tsc --declaration --emitDeclarationOnly --outDir dist" },
  "peerDependencies": { "vue": "^3.3.0" },
  "devDependencies": { "@vitejs/plugin-vue": "^5.2.0", "typescript": "^5.7.0", "vite": "^6.0.0", "vue": "^3.5.0", "vue-tsc": "^2.2.0" }
}
